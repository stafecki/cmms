# Used for local development without Docker (running API directly with `npm run dev`)
# When running with Docker, these are overridden by docker-compose environment variables

DATABASE_URL="mysql://root:root_password@localhost:3306/cmms_db"
DATABASE_USER=cmms_user
DATABASE_PASSWORD=cmms_password
DATABASE_NAME=cmms_db
DATABASE_HOST=localhost
DATABASE_PORT=3306

MONGO_URI="mongodb://cmms_mongo:mongo_password@localhost:27017/cmms_logs?authSource=admin"
REDIS_URL="redis://:redis_password@localhost:6379"

JWT_SECRET=change_this_to_a_secure_random_string

NODE_ENV=development
PORT=3000
